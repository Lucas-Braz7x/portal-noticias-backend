# Application
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal_noticias?schema=public"

# Base URL para testes de integração (schema criado dinamicamente por run)
TEST_DATABASE_BASE_URL="postgresql://portal:portal@localhost:5432/portal_noticias_test"

# Ingestão de artigos
INGEST_API_KEY="change-me-in-production"

# OpenSearch
OPENSEARCH_NODE="http://localhost:9200"

# LocalStack (AWS local — SQS para indexação assíncrona em dev)
AWS_ENDPOINT_URL="http://localhost:4566"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
SQS_INDEX_QUEUE_URL="http://localhost:4566/000000000000/article-index"
