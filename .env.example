# Application
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://portal:portal@localhost:5432/portal_noticias?schema=public"

# Base URL para testes de integração (schema criado dinamicamente por run)
TEST_DATABASE_BASE_URL="postgresql://portal:portal@localhost:5432/portal_noticias_test"

# Ingestão de artigos
INGEST_API_KEY="change-me-in-production"

# OpenSearch (false = busca q via PostgreSQL ILIKE, sem ranking)
OPENSEARCH_ENABLED=true
OPENSEARCH_NODE="http://localhost:9200"
SEARCH_REINDEX_ON_STARTUP=true

# Cache HTTP (GET) — TTL em segundos
CACHE_ARTICLES_MAX_AGE=60
CACHE_SEARCH_MAX_AGE=30
CACHE_CATALOG_MAX_AGE=300

# Invalidação ISR do frontend após ingestão (opcional — Render)
FRONTEND_REVALIDATE_URL=
REVALIDATE_SECRET=

# Indexação — sync (dev) ou async (Render API)
INDEXING_MODE=sync

# Background Worker (yarn start:worker) — poll da tabela index_jobs
INDEX_WORKER_POLL_MS=2000
INDEX_WORKER_BATCH_SIZE=5
INDEX_WORKER_MAX_ATTEMPTS=5

# LocalStack (AWS local — simulação SQS em dev; produção Render usa Outbox PG)
AWS_ENDPOINT_URL="http://localhost:4566"
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="test"
AWS_SECRET_ACCESS_KEY="test"
SQS_INDEX_QUEUE_URL="http://localhost:4566/000000000000/article-index"
